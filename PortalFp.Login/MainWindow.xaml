<Window x:Class="PortalFp.Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PortalFp.Login"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="30">

		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Image Source="/Images/logo.png"
               Grid.Row="1"
               HorizontalAlignment="Center"
               Width="150"
               Height="150"
               Margin="0,0,0,10"/>

		<Label Grid.Row="2"
           Content="_Usuario:"
           Target="{Binding ElementName=TxtUsuario}"
           Width="300"/>

		<TextBox Grid.Row="3"
             x:Name="TxtUsuario"
             Width="300"
             Margin="0,0,0,15"/>

		<Label Grid.Row="4"
           Content="_Contraseña:"
           Target="{Binding ElementName=TxtPassword}"
           Width="300"/>

		<PasswordBox Grid.Row="5"
                 x:Name="TxtPassword"
                 Margin="0,0,0,20"
                 Width="300"/>

		<Button Grid.Row="6"
            Content="Acceder"
            IsDefault="True"
            Padding="10"
            Width="300"
            Click="BtnAcceder_Click"/>

		<TextBlock Grid.Row="7"
           x:Name="TxtMensaje"
           HorizontalAlignment="Center"
           FontWeight="Bold"
           Margin="0,15,0,0"/>

	</Grid>
</Window>
